<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:manipulatorMobileApp.Controls"
             x:Class="manipulatorMobileApp.Views.ChatPage"
             BackgroundColor="#111111"
             Title="Chat">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <CollectionView Grid.Row="0"
                        x:Name="messagesList"
                        Margin="0,6,0,0"
                        SelectionMode="None"
                        VerticalOptions="FillAndExpand"
                        ItemSizingStrategy="MeasureAllItems">
            <CollectionView.Header>
                <Frame x:Name="imageHintFrame"
                       Margin="14,8,14,10"
                       Padding="14,10"
                       CornerRadius="14"
                       BackgroundColor="#2A2A2C"
                       HasShadow="False">
                    <Label Text="Image will be attached to your first message"
                           TextColor="#AAAAAA"
                           FontSize="Small"
                           LineBreakMode="WordWrap"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center"/>
                </Frame>
            </CollectionView.Header>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="8"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,0,0,2">
                        <Frame BackgroundColor="{Binding BubbleColor}"
                               CornerRadius="18"
                               Padding="14,10"
                               Margin="{Binding BubbleMargin}"
                               HorizontalOptions="{Binding BubbleAlignment}"
                               HasShadow="False">
                            <Grid>
                                <StackLayout Orientation="Horizontal"
                                             Spacing="8"
                                             IsVisible="{Binding IsPendingVisible}">
                                    <ActivityIndicator IsRunning="{Binding IsPending}"
                                                       Color="#74AFFF"
                                                       WidthRequest="18"
                                                       HeightRequest="18"
                                                       VerticalOptions="Center"/>
                                    <Label Text="{Binding Content}"
                                           TextColor="#D6E3FF"
                                           FontSize="Default"
                                           VerticalTextAlignment="Center"
                                           LineBreakMode="WordWrap"/>
                                </StackLayout>
                                <Label Text="{Binding Content}"
                                       IsVisible="{Binding IsMessageVisible}"
                                       TextColor="White"
                                       FontSize="Default"
                                       LineBreakMode="WordWrap"/>
                            </Grid>
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <BoxView HeightRequest="8"
                         Color="Transparent"/>
            </CollectionView.Footer>
        </CollectionView>

        <Grid Grid.Row="1"
              BackgroundColor="#1C1C1E"
              Padding="12,8,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="56"/>
            </Grid.ColumnDefinitions>

            <Frame Grid.Column="0"
                   CornerRadius="20"
                   Padding="14,8"
                   BackgroundColor="#2C2C2E"
                   HasShadow="False"
                   Margin="0,0,8,0">
                <controls:ChatInputEditor x:Name="messageEntry"
                                          Placeholder="Ask about the image…"
                                          PlaceholderColor="#666666"
                                          TextColor="White"
                                          BackgroundColor="Transparent"
                                          AutoSize="TextChanges"
                                          SizeChanged="MessageEntry_SizeChanged"
                                          TextChanged="MessageEntry_TextChanged"
                                          VerticalOptions="Center"
                                          MaxLength="2000"/>
            </Frame>

            <Button Grid.Column="1"
                    x:Name="sendBtn"
                    Text="➤"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#2A78E4"
                    CornerRadius="24"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="0"
                    VerticalOptions="Start"
                    Clicked="SendBtn_Clicked"/>
        </Grid>
    </Grid>
</ContentPage>
